{
  "colors": {
    "bg": "#fdf2f8",
    "card": "rgba(255,255,255,0.7)",
    "glass": "rgba(255,255,255,0.4)",
    "accent": "#e8a0bf",
    "accent2": "#d4a0c0",
    "accent3": "#c9b1d0",
    "text": "#2d1b2d",
    "textMuted": "rgba(45,27,45,0.6)",
    "glow": "rgba(232,160,191,0.3)"
  },
  "nightColors": {
    "bg": "#1a0a1a",
    "card": "rgba(255,255,255,0.08)",
    "glass": "rgba(255,255,255,0.05)",
    "text": "#ffffff",
    "textMuted": "rgba(255,255,255,0.6)"
  },
  "fonts": {
    "heading": "Playfair Display",
    "script": "Caveat",
    "body": "Quicksand"
  },
  "borderRadius": "24px",
  "animationProfile": "luxe",
  "sections": {
    "hero": {
      "gradient": "linear-gradient(135deg, rgba(232,160,191,0.3), rgba(201,177,208,0.3))",
      "parallaxSpeed": 0.5
    },
    "memories": {
      "layout": "masonry",
      "polaroidStyle": true,
      "tiltAngle": 3,
      "maxColumns": 3
    },
    "reasons": {
      "flipCard": true,
      "gridColumns": 4,
      "randomButton": true,
      "adaptiveLayout": true
    },
    "letter": {
      "envelopeAnimation": true,
      "typewriterSpeed": 40,
      "fontFamily": "Caveat"
    },
    "cake": {
      "style": "css-3d",
      "stages": ["blow", "cut", "slice"],
      "nightMode": true,
      "confettiOnComplete": true
    },
    "final": {
      "nightMode": true,
      "cinematicReveal": true
    }
  },
  "navbar": {
    "style": "glassmorphism",
    "blur": "20px",
    "opacity": 0.7
  },
  "cursor": {
    "glow": true,
    "glowColor": "rgba(232,160,191,0.4)",
    "glowSize": 200
  },
  "floatingElements": {
    "enabled": true,
    "types": ["star", "heart", "sparkle"],
    "count": 15,
    "speed": 0.3
  }
}
